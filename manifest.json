{
  "manifest_version": 3,
  "name": "Braintox - Save to Brain",
  "version": "1.1.0",
  "description": "Save any webpage to your Braintox knowledge base with one click. AI-powered auto-tagging included.",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
